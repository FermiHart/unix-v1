    dw 0x8906
    dw 0x0A1F, LOAD+read_fd
    dw 0x0BDF, LOAD+file_mode
    dw 0x0302
    dw 0x005F, LOAD+leave
    dw 0x0BDF, LOAD+command_mode
    dw 0x0302
    dw 0x005F, LOAD+leave
    dw 0x005F, LOAD+prompt
command_string:
    dw 0x17C1, LOAD+pending_command
    dw 0x0BC1
    dw 0x0202
    dw 0x005F, LOAD+leave
    dw 0x0A1F, LOAD+pending_command
    dw 0x15C5, LOAD+line_buffer
    dw 0x0A04
copy_command:
    dw 0x9440
    dw 0x8BC0
    dw 0x0202
    dw 0x005F, LOAD+terminate_line
    dw 0xA5C0, 10
    dw 0x0202
    dw 0x005F, LOAD+syntax_error
    dw 0xA5C0, 9
    dw 0x0202
    dw 0x005F, LOAD+copy_command_byte
    dw 0xB5C0, 0x60
    dw 0x0202
    dw 0x005F, LOAD+syntax_error
copy_command_byte:
    dw 0x25C4, 119
    dw 0x0202
    dw 0x005F, LOAD+report_long_input
    dw 0x9015
    dw 0x0A84
    dw 0x005F, LOAD+copy_command
usage_error:
    dw 0x15C1, LOAD+usage_message
    dw 0x15C2, usage_message_end-usage_message
    dw 0x09DF, LOAD+write_error
    dw 0x005F, LOAD+leave
source_error:
    dw 0x15C1, LOAD+source_message
    dw 0x15C2, source_message_end-source_message
    dw 0x0BDF, LOAD+file_mode
    dw 0x0302
    dw 0x005F, LOAD+fatal_source_error
    dw 0x005F, LOAD+report_error
fatal_source_error:
    dw 0x09DF, LOAD+write_error
    dw 0x005F, LOAD+leave
nested_source_error:
    dw 0x15C1, LOAD+nested_source_message
    dw 0x15C2, nested_source_message_end-nested_source_message
    dw 0x005F, LOAD+report_error
; Session history contains only successfully parsed interactive input.
; Recall does not add a duplicate; history commands and source-file bodies
; are excluded. No history file is created on either emulated disk.
prepare_history:
    dw 0x0A1F, LOAD+history_candidate_valid
    dw 0x15C1, LOAD+line_buffer
history_leading_space:
    dw 0x9240
    dw 0xA5C0, 32
    dw 0x0203
    dw 0x0A81
    dw 0x005F, LOAD+history_leading_space
    dw 0xA5C0, 9
    dw 0x0203
    dw 0x0A81
    dw 0x005F, LOAD+history_leading_space
    dw 0xA5C0, 33
    dw 0x0302
    dw 0x005F, LOAD+save_history_candidate
    dw 0x0BDF, LOAD+read_fd
    dw 0x0302
    dw 0x005F, LOAD+history_abort
    dw 0x0BDF, LOAD+command_mode
    dw 0x0302
    dw 0x005F, LOAD+history_abort
    dw 0x0A81
    dw 0x9440
    dw 0xA5C0, 33
    dw 0x0202
    dw 0x005F, LOAD+latest_history
    dw 0x2017, 49                   ; CMP R0,#'1'
    dw 0x0402
    dw 0x005F, LOAD+history_abort
    dw 0x2017, 52                   ; CMP R0,#'4'
    dw 0x0702
    dw 0x005F, LOAD+history_abort
    dw 0xE5C0, 49
    dw 0x005F, LOAD+recall_tail
latest_history:
    dw 0x17C0, LOAD+history_count
    dw 0x0BC0
    dw 0x0202
    dw 0x005F, LOAD+history_abort
    dw 0x0AC0
recall_tail:
    dw 0x1004
recall_tail_byte:
    dw 0x9443
    dw 0x8BC3
    dw 0x0202
    dw 0x005F, LOAD+recall_selected
    dw 0xA5C3, 32
    dw 0x0202
    dw 0x005F, LOAD+recall_tail_byte
    dw 0xA5C3, 9
    dw 0x0202
    dw 0x005F, LOAD+recall_tail_byte
    dw 0x005F, LOAD+history_abort
recall_selected:
    dw 0x1100
    dw 0x201F, LOAD+history_count
    dw 0x0502
    dw 0x005F, LOAD+history_abort
    dw 0x09DF, LOAD+history_address
    dw 0x1081
    dw 0x15C2, LOAD+line_buffer
recall_copy:
    dw 0x9452
    dw 0x0302
    dw 0x005F, LOAD+recall_copy
    dw 0xE5C2, LOAD+line_buffer+1
    dw 0x15C1, LOAD+line_buffer
    dw 0x09DF, LOAD+write_string
    dw 0x15C1, LOAD+newline
    dw 0x15C2, 1
    dw 0x09DF, LOAD+write_string
    dw 0x0087
history_abort:
    dw 0x0BD6
    dw 0x15C1, LOAD+history_error_message
    dw 0x15C2, history_error_message_end-history_error_message
    dw 0x005F, LOAD+report_error
save_history_candidate:
    dw 0x0BDF, LOAD+read_fd
    dw 0x0302
    dw 0x005F, LOAD+history_ready
    dw 0x0BDF, LOAD+command_mode
    dw 0x0302
    dw 0x005F, LOAD+history_ready
    dw 0x0BDF, LOAD+history_enabled
    dw 0x0202
    dw 0x005F, LOAD+history_ready
    dw 0x15C1, LOAD+line_buffer
    dw 0x15C2, LOAD+history_candidate
candidate_copy:
    dw 0x9452
    dw 0x0302
    dw 0x005F, LOAD+candidate_copy
    dw 0x15DF, 1, LOAD+history_candidate_valid
history_ready:
    dw 0x0087
commit_history:
    dw 0x0BDF, LOAD+history_candidate_valid
    dw 0x0202
    dw 0x005F, LOAD+history_ready
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+history_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+history_ready
    dw 0x25DF, 4, LOAD+history_count
    dw 0x0202
    dw 0x005F, LOAD+shift_history
    dw 0x17C0, LOAD+history_count
    dw 0x0A9F, LOAD+history_count
    dw 0x005F, LOAD+insert_history
shift_history:
    dw 0x15C1, LOAD+history_buffer+120
    dw 0x15C2, LOAD+history_buffer
    dw 0x15C3, 360
history_shift_byte:
    dw 0x9452
    dw 0x0AC3
    dw 0x0302
    dw 0x005F, LOAD+history_shift_byte
    dw 0x15C0, 3
insert_history:
    dw 0x09DF, LOAD+history_address
    dw 0x15C1, LOAD+history_candidate
history_insert_byte:
    dw 0x9452
    dw 0x0302
    dw 0x005F, LOAD+history_insert_byte
    dw 0x0087
history_address:
    dw 0x0CC0
    dw 0x1C02, LOAD+history_addresses
    dw 0x0087
clear_history:
    dw 0x0A1F, LOAD+history_count
    dw 0x0A1F, LOAD+history_candidate_valid
    dw 0x15C1, LOAD+history_buffer
    dw 0x15C3, 608
history_clear_byte:
    dw 0x8A11
    dw 0x0AC3
    dw 0x0302
    dw 0x005F, LOAD+history_clear_byte
    dw 0x0087
empty_command:
    dw 0x09DF, LOAD+has_redirect
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+syntax_error
    dw 0x005F, LOAD+prompt
has_redirect:
    dw 0x17C0, LOAD+input_path
    dw 0x57C0, LOAD+output_path
    dw 0x0087
stateful_begin:
    dw 0x09DF, LOAD+has_redirect
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+stateful_redirect_abort
    dw 0x0087
stateful_redirect_abort:
    dw 0x0BD6
    dw 0x15C1, LOAD+builtin_redirect_message
    dw 0x15C2, builtin_redirect_message_end-builtin_redirect_message
    dw 0x005F, LOAD+report_error
pure_begin:
    dw 0x09DF, LOAD+has_redirect
