    dw 0x15C2, LOAD+off_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+disable_history
    dw 0x17C1, LOAD+arguments+2
    dw 0x15C2, LOAD+on_name
