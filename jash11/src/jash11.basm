startup_script:
    dw 0x15DF, 1, LOAD+file_mode
open_source:
    dw 0x105F, LOAD+source_filename
    dw 0x105F, LOAD+source_stat_arg
    dw 0x8912
source_stat_arg:
    dw 0, LOAD+file_stat
    dw 0x8602
    dw 0x005F, LOAD+source_error
    dw 0x35DF, 0x4000, LOAD+file_stat+2
    dw 0x0302
    dw 0x005F, LOAD+source_error
    dw 0x17C0, LOAD+file_stat
    dw 0x2017, 41                   ; device inodes 1..40 are not command files
    dw 0x0402
    dw 0x005F, LOAD+source_error
    dw 0x8905
source_filename:
    dw 0, 0
    dw 0x8602
    dw 0x005F, LOAD+source_error
    dw 0x101F, LOAD+read_fd
    dw 0x005F, LOAD+prompt
finish_source:
    dw 0x17C0, LOAD+read_fd
    dw 0x0BC0
    dw 0x0202
