; Copyright (c) 2026, F E R M I ∞ H A R T <contact@fermihart.com>
; License: original unix-v1 terms; see ../../LICENSE.
;
; Jash/11: a bounded, independently implemented native PDP-11 shell profile.
; No source is copied from the modern Jash implementation. ANSI SGR values
; follow its default Midnight palette: banner 96, prompt 97 + bold.
; Bear Basm emits explicit PDP-11 words, not x86 instructions. BITS 64
; selects the assembler container only. The 0407 loader places text at
; 040000 octal; LOAD converts a file-offset label into a guest address.
; Branches use fixed local skips; non-local control flow uses absolute JMP.
BITS 64
section .text
LOAD equ 0x3FF0
    dw 0x0107, image_end-text, 0, 0, 0, 0, 0, 0
text:
    dw 0x8905, LOAD+console_name, 1  ; establish diagnostics before parsing CLI options
    dw 0x8702
    dw 0x101F, LOAD+error_fd
    dw 0x1383                       ; MOV (SP),R3: argc
    dw 0x1185                       ; MOV SP,R5
    dw 0x65C5, 4                    ; argv[1]
    dw 0x0AC3
cli_next:
    dw 0x0BC3
    dw 0x0202
    dw 0x005F, LOAD+identify
    dw 0x1544                       ; MOV (R5)+,R4: next argument (byte-safe strings)
    dw 0x0AC3
    dw 0x1101
    dw 0x15C2, LOAD+option_plain
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+cli_plain
    dw 0x1101
    dw 0x15C2, LOAD+option_command
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+cli_command
    dw 0xA5CC, 45                   ; unknown option is not a script filename
    dw 0x0202
    dw 0x005F, LOAD+usage_error
    dw 0x0BC3
    dw 0x0302
    dw 0x005F, LOAD+usage_error
    dw 0x111F, LOAD+startup_file
    dw 0x005F, LOAD+identify
cli_plain:
    dw 0x0A1F, LOAD+colored          ; CLR colored
    dw 0x005F, LOAD+cli_next
cli_command:
    dw 0x25C3, 1
    dw 0x0302
    dw 0x005F, LOAD+usage_error
    dw 0x1341                       ; MOV (R5),R1: command string
    dw 0x105F, LOAD+pending_command
    dw 0x15DF, 1, LOAD+command_mode
    dw 0x005F, LOAD+identify
identify:
    dw 0x8918                       ; SYS getuid
    dw 0x0BC0                       ; TST R0
    dw 0x0306                       ; BEQ banner_select
    dw 0x95DF, 36, LOAD+plain_prompt ; MOVB #'$',@#plain_prompt
    dw 0x95DF, 36, LOAD+prompt_mark
banner_select:
    dw 0x17C1, LOAD+startup_file
    dw 0x0BC1
    dw 0x0302
    dw 0x005F, LOAD+startup_script
    dw 0x0BDF, LOAD+command_mode
    dw 0x0302
    dw 0x005F, LOAD+prompt
    dw 0x0BDF, LOAD+colored          ; TST colored
    dw 0x0202
    dw 0x005F, LOAD+plain_banner
    dw 0x15C1, LOAD+banner_color
    dw 0x15C2, banner_color_end-banner_color
    dw 0x09DF, LOAD+write_string     ; JSR PC,@#write_string
    dw 0x005F, LOAD+prompt
plain_banner:
    dw 0x15C1, LOAD+banner
    dw 0x15C2, banner_end-banner
    dw 0x09DF, LOAD+write_string
prompt:
    dw 0x0BDF, LOAD+read_fd
    dw 0x0302
    dw 0x005F, LOAD+read_line
    dw 0x0BDF, LOAD+command_mode
    dw 0x0302
    dw 0x005F, LOAD+command_string
    dw 0x0BDF, LOAD+colored
    dw 0x0202
    dw 0x005F, LOAD+prompt_plain
    dw 0x15C1, LOAD+color_prompt
    dw 0x15C2, color_prompt_end-color_prompt
    dw 0x09DF, LOAD+write_string
    dw 0x005F, LOAD+read_line
prompt_plain:
    dw 0x15C1, LOAD+plain_prompt
    dw 0x15C2, 2
    dw 0x09DF, LOAD+write_string
read_line:
    dw 0x15C5, LOAD+line_buffer      ; R5 = bounded output cursor
    dw 0x0A04                       ; R4 = normalized line length
    dw 0x0A1F, LOAD+line_error
    dw 0x0A1F, LOAD+paste_active
    dw 0x0A1F, LOAD+escape_state
read_byte:
    dw 0x17C0, LOAD+read_fd          ; command files do not replace child stdin
    dw 0x8903, LOAD+input_byte, 1    ; V1 canon chunks are not command boundaries
    dw 0x8602                       ; BCC: read succeeded
    dw 0x005F, LOAD+read_error
    dw 0x0BC0
    dw 0x0202
    dw 0x005F, LOAD+input_eof
    dw 0x97C0, LOAD+input_byte       ; MOVB @#input_byte,R0
    dw 0x0BDF, LOAD+escape_state
    dw 0x0202
    dw 0x005F, LOAD+input_character
    dw 0x005F, LOAD+escape_byte
input_character:
    dw 0xA5C0, 27                   ; ESC begins a terminal marker, not syntax
    dw 0x0202
    dw 0x005F, LOAD+start_escape
    dw 0xA5C0, 10
    dw 0x0202
    dw 0x005F, LOAD+end_input_line
    dw 0xA5C0, 9                    ; TAB remains an argument separator
    dw 0x0202
    dw 0x005F, LOAD+store_character
    dw 0xB5C0, 0x60                 ; reject other nonprinting input, including NUL
    dw 0x0202
    dw 0x005F, LOAD+invalid_character
    dw 0xA5C0, 127
    dw 0x0202
    dw 0x005F, LOAD+invalid_character
store_character:
    dw 0x0BDF, LOAD+line_error
    dw 0x0302
    dw 0x005F, LOAD+read_byte         ; keep draining an invalid line/paste
    dw 0x25C4, 119
    dw 0x0202
    dw 0x005F, LOAD+overflow_input
    dw 0x9015                       ; MOVB R0,(R5)+
    dw 0x0A84                       ; INC R4
    dw 0x005F, LOAD+read_byte
overflow_input:
    dw 0x15DF, 1, LOAD+line_error
    dw 0x005F, LOAD+read_byte
invalid_character:
    dw 0x15DF, 2, LOAD+line_error
    dw 0x005F, LOAD+read_byte
start_escape:
    dw 0x15DF, 1, LOAD+escape_state
    dw 0x005F, LOAD+read_byte
; Recognize only the standard six-byte bracketed-paste markers. State is
; retained across V1's 120-byte canonical chunks. Unknown CSI input is an
; explicit input error, never silently converted into an executable command.
escape_byte:
    dw 0x17C3, LOAD+escape_state
    dw 0x25C3, 1
    dw 0x0202
    dw 0x005F, LOAD+escape_bracket
    dw 0x25C3, 2
    dw 0x0202
    dw 0x005F, LOAD+escape_two
    dw 0x25C3, 3
    dw 0x0202
    dw 0x005F, LOAD+escape_zero
    dw 0x25C3, 4
    dw 0x0202
    dw 0x005F, LOAD+escape_kind_byte
    dw 0xA5C0, 126                  ; final '~'
    dw 0x0302
    dw 0x005F, LOAD+bad_escape
    dw 0x0A1F, LOAD+escape_state
    dw 0x0BDF, LOAD+escape_kind
    dw 0x0302
    dw 0x005F, LOAD+close_paste
    dw 0x0BDF, LOAD+paste_active
    dw 0x0302
    dw 0x005F, LOAD+invalid_character ; nested markers are not supported
    dw 0x15DF, 1, LOAD+paste_active
    dw 0x005F, LOAD+read_byte
close_paste:
    dw 0x0BDF, LOAD+paste_active
    dw 0x0202
    dw 0x005F, LOAD+invalid_character ; unmatched close marker
    dw 0x0A1F, LOAD+paste_active
    dw 0x005F, LOAD+read_byte
escape_bracket:
    dw 0xA5C0, 91
    dw 0x0302
    dw 0x005F, LOAD+bad_escape
    dw 0x005F, LOAD+next_escape_byte
escape_two:
    dw 0xA5C0, 50
    dw 0x0302
    dw 0x005F, LOAD+bad_escape
    dw 0x005F, LOAD+next_escape_byte
escape_zero:
    dw 0xA5C0, 48
    dw 0x0302
    dw 0x005F, LOAD+bad_escape
    dw 0x005F, LOAD+next_escape_byte
escape_kind_byte:
    dw 0xA5C0, 48
    dw 0x0202
    dw 0x005F, LOAD+paste_begin_kind
    dw 0xA5C0, 49
    dw 0x0302
    dw 0x005F, LOAD+bad_escape
    dw 0x15DF, 1, LOAD+escape_kind
    dw 0x005F, LOAD+next_escape_byte
paste_begin_kind:
    dw 0x0A1F, LOAD+escape_kind
next_escape_byte:
    dw 0x0A9F, LOAD+escape_state
    dw 0x005F, LOAD+read_byte
bad_escape:
    dw 0x15DF, 2, LOAD+line_error
    dw 0x0A1F, LOAD+escape_state
    dw 0x005F, LOAD+input_character   ; LF must still terminate malformed input
end_input_line:
    dw 0x0BDF, LOAD+paste_active
    dw 0x0302
    dw 0x005F, LOAD+multiline_input
    dw 0x0BDF, LOAD+line_error
    dw 0x0302
    dw 0x005F, LOAD+report_input_error
    dw 0x005F, LOAD+terminate_line
multiline_input:
    dw 0x15DF, 3, LOAD+line_error     ; reject the entire paste, not just its first line
    dw 0x005F, LOAD+read_byte
input_eof:
    dw 0x0BDF, LOAD+line_error
    dw 0x0302
    dw 0x005F, LOAD+finish_source
    dw 0x0BDF, LOAD+paste_active
    dw 0x0302
    dw 0x005F, LOAD+finish_source
    dw 0x0BDF, LOAD+escape_state
    dw 0x0302
    dw 0x005F, LOAD+finish_source
    dw 0x0BC4
    dw 0x0202
    dw 0x005F, LOAD+finish_source
terminate_line:
    dw 0x8A0D                       ; CLRB (R5)
    dw 0x09DF, LOAD+prepare_history
    dw 0x15C1, LOAD+line_buffer
    dw 0x15C5, LOAD+line_buffer      ; compact tokens in place, behind the reader
    dw 0x15C2, LOAD+arguments
    dw 0x0A03                       ; CLR R3: argc
    dw 0x0A04                       ; R4 = quote delimiter, or zero
    dw 0x0A1F, LOAD+word_open
    dw 0x0A1F, LOAD+redirect_pending
    dw 0x0A1F, LOAD+input_path
    dw 0x0A1F, LOAD+output_path
    dw 0x0A1F, LOAD+append_mode
    dw 0x0A1F, LOAD+in_child
lex_byte:
    dw 0x9440                       ; MOVB (R1)+,R0
    dw 0x8BC0                       ; TSTB R0
    dw 0x0202
    dw 0x005F, LOAD+lex_end
    dw 0x0BC4
    dw 0x0302
    dw 0x005F, LOAD+quoted_byte
    dw 0xA5C0, 32
    dw 0x0202
    dw 0x005F, LOAD+end_word
    dw 0xA5C0, 9
    dw 0x0202
    dw 0x005F, LOAD+end_word
    dw 0xA5C0, 35                   ; comments start only at an unquoted word boundary
    dw 0x0202
    dw 0x005F, LOAD+comment_start
    dw 0xA5C0, 34
    dw 0x0202
    dw 0x005F, LOAD+open_quote
    dw 0xA5C0, 39
    dw 0x0202
    dw 0x005F, LOAD+open_quote
    dw 0xA5C0, 92
    dw 0x0202
    dw 0x005F, LOAD+escaped_byte
    dw 0xA5C0, 60
    dw 0x0202
    dw 0x005F, LOAD+redirect_operator
    dw 0xA5C0, 62
    dw 0x0202
    dw 0x005F, LOAD+redirect_operator
    dw 0x1026                       ; preserve quote state while scanning specials
    dw 0x1126
    dw 0x15C4, LOAD+unsupported
scan_special:
    dw 0x8BCC                       ; TSTB (R4)
    dw 0x0202
    dw 0x005F, LOAD+ordinary_byte
    dw 0xA500                       ; CMPB (R4)+,R0
    dw 0x0202
    dw 0x005F, LOAD+lex_special_error
    dw 0x005F, LOAD+scan_special
comment_start:
    dw 0x0BDF, LOAD+word_open
    dw 0x0202
    dw 0x005F, LOAD+lex_end
    dw 0x005F, LOAD+store_word_byte
ordinary_byte:
    dw 0x1584                       ; MOV (SP)+,R4
    dw 0x1580                       ; MOV (SP)+,R0
store_word_byte:
    dw 0x09DF, LOAD+word_start
    dw 0x9015                       ; MOVB R0,(R5)+
    dw 0x005F, LOAD+lex_byte
lex_special_error:
    dw 0x1584
    dw 0x1580
    dw 0x005F, LOAD+syntax_error
open_quote:
    dw 0x09DF, LOAD+word_start
    dw 0x1004                       ; MOV R0,R4: delimiter
    dw 0x005F, LOAD+lex_byte
quoted_byte:
    dw 0xA100                       ; CMPB R4,R0
    dw 0x0202
    dw 0x005F, LOAD+close_quote
    dw 0x25C4, 34
    dw 0x0302
    dw 0x005F, LOAD+store_word_byte  ; single quotes keep backslashes literal
    dw 0xA5C0, 92
    dw 0x0202
    dw 0x005F, LOAD+escaped_byte
    dw 0x005F, LOAD+store_word_byte
close_quote:
    dw 0x0A04
    dw 0x005F, LOAD+lex_byte
escaped_byte:
    dw 0x9440
    dw 0x8BC0
    dw 0x0202
    dw 0x005F, LOAD+quote_error
    dw 0x005F, LOAD+store_word_byte
end_word:
    dw 0x0BDF, LOAD+word_open
    dw 0x0202
    dw 0x005F, LOAD+lex_byte
    dw 0x8A15                       ; CLRB (R5)+
    dw 0x0A1F, LOAD+word_open
    dw 0x005F, LOAD+lex_byte
lex_end:
    dw 0x0BC4
    dw 0x0302
    dw 0x005F, LOAD+quote_error
    dw 0x8A0D
    dw 0x0BDF, LOAD+redirect_pending
    dw 0x0302
    dw 0x005F, LOAD+syntax_error
    dw 0x17C0, LOAD+input_path
    dw 0x0BC0
    dw 0x0202
    dw 0x005F, LOAD+check_output_name
    dw 0x8BC8                       ; TSTB (R0): no empty filename
    dw 0x0202
    dw 0x005F, LOAD+syntax_error
check_output_name:
    dw 0x17C0, LOAD+output_path
    dw 0x0BC0
    dw 0x0202
    dw 0x005F, LOAD+parsed
    dw 0x8BC8
    dw 0x0202
    dw 0x005F, LOAD+syntax_error
    dw 0x005F, LOAD+parsed
redirect_operator:
    dw 0x0BDF, LOAD+redirect_pending
    dw 0x0302
    dw 0x005F, LOAD+syntax_error
    dw 0x0BDF, LOAD+word_open
    dw 0x0303
    dw 0x8A15
    dw 0x0A1F, LOAD+word_open
    dw 0xA5C0, 60
    dw 0x0202
    dw 0x005F, LOAD+redirect_in
    dw 0x0BDF, LOAD+output_path
    dw 0x0302
    dw 0x005F, LOAD+syntax_error
    dw 0x15DF, 2, LOAD+redirect_pending
    dw 0xA5C9, 62                   ; CMPB #'>',(R1): optional append operator
    dw 0x0302
    dw 0x005F, LOAD+lex_byte
    dw 0x0A81
    dw 0x15DF, 1, LOAD+append_mode
    dw 0x005F, LOAD+lex_byte
redirect_in:
    dw 0x0BDF, LOAD+input_path
    dw 0x0302
    dw 0x005F, LOAD+syntax_error
    dw 0x15DF, 1, LOAD+redirect_pending
    dw 0x005F, LOAD+lex_byte
word_start:
    dw 0x0BDF, LOAD+word_open
    dw 0x0302
    dw 0x005F, LOAD+word_started
    dw 0x0BDF, LOAD+redirect_pending
    dw 0x0302
    dw 0x005F, LOAD+redirect_word
    dw 0x25C3, 8
    dw 0x0203
    dw 0x0BD6                       ; discard this helper's return on parser abort
    dw 0x005F, LOAD+argument_error
    dw 0x1152                       ; MOV R5,(R2)+
    dw 0x0A83
    dw 0x005F, LOAD+mark_word_open
redirect_word:
    dw 0x25DF, 1, LOAD+redirect_pending
    dw 0x0202
    dw 0x005F, LOAD+input_word
    dw 0x115F, LOAD+output_path      ; MOV R5,@#output_path
    dw 0x005F, LOAD+redirect_word_done
input_word:
    dw 0x115F, LOAD+input_path
redirect_word_done:
    dw 0x0A1F, LOAD+redirect_pending
mark_word_open:
    dw 0x15DF, 1, LOAD+word_open
word_started:
    dw 0x0087
parsed:
    dw 0x0A0A                       ; CLR (R2): argv terminator
    dw 0x10DF, LOAD+argument_count   ; MOV R3,@#argument_count
    dw 0x0BC3
    dw 0x0202
    dw 0x005F, LOAD+empty_command
    dw 0x09DF, LOAD+commit_history
dispatch:
    dw 0x17C1, LOAD+arguments        ; MOV @#arguments,R1
    dw 0x15C2, LOAD+exit_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+exit_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+help_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+help_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+version_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+version_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+plain_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+plain_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+color_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+color_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+cd_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+cd_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+source_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+source_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+history_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+history_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+complete_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+complete_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+echo_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+echo_builtin
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+chdir_name
    dw 0x09DF, LOAD+equal_string
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+cd_builtin
    dw 0x0BDF, LOAD+in_child
    dw 0x0302
    dw 0x005F, LOAD+exec_external
fork_command:
    dw 0x8902                       ; SYS fork: child executes next BR;
    dw 0x0105                       ; parent skips it (V1 ABI, not POSIX)
    dw 0x8602                       ; BCC: successful parent return
    dw 0x005F, LOAD+fork_error
    dw 0x005F, LOAD+wait_child
    dw 0x005F, LOAD+run_child
wait_child:
    dw 0x1004                       ; MOV R0,R4: child pid
wait_again:
    dw 0x8907                       ; SYS wait
    dw 0x8602
    dw 0x005F, LOAD+wait_error
    dw 0x2004                       ; CMP R0,R4
    dw 0x0302
    dw 0x005F, LOAD+wait_again
    dw 0x005F, LOAD+prompt
run_child:
    dw 0x15DF, 1, LOAD+in_child
    dw 0x17C0, LOAD+read_fd
    dw 0x0BC0
    dw 0x0301
    dw 0x8906                       ; do not leak source/script descriptors into exec
    dw 0x17C1, LOAD+input_path
    dw 0x0BC1
    dw 0x0202
    dw 0x005F, LOAD+redirect_output
    dw 0x105F, LOAD+open_input_arg
    dw 0x0A00
    dw 0x8906                       ; close stdin in the child only
    dw 0x8905
open_input_arg:
    dw 0, 0
    dw 0x8602
    dw 0x005F, LOAD+input_redirect_error
    dw 0x0BC0
    dw 0x0302
    dw 0x005F, LOAD+input_redirect_error
redirect_output:
    dw 0x17C1, LOAD+output_path
    dw 0x0BC1
    dw 0x0202
    dw 0x005F, LOAD+dispatch
    dw 0x105F, LOAD+create_output_arg
    dw 0x105F, LOAD+append_output_arg
    dw 0x15C0, 1
    dw 0x8906                       ; close stdout only after input succeeded
    dw 0x0BDF, LOAD+append_mode
    dw 0x0202
    dw 0x005F, LOAD+create_output
    dw 0x8905
append_output_arg:
    dw 0, 1
    dw 0x8702
    dw 0x005F, LOAD+output_opened
create_output:
    dw 0x8908
create_output_arg:
    dw 0, 0x000F
    dw 0x8602
    dw 0x005F, LOAD+output_redirect_error
output_opened:
    dw 0x25C0, 1
    dw 0x0302
    dw 0x005F, LOAD+output_redirect_error
    dw 0x0BDF, LOAD+append_mode
    dw 0x0202
    dw 0x005F, LOAD+dispatch
    dw 0x8913, 0, 2                 ; SYS seek: stdout offset 0 from end
    dw 0x8602
    dw 0x005F, LOAD+output_redirect_error
    dw 0x005F, LOAD+dispatch
exec_external:
    dw 0x17C1, LOAD+arguments
    dw 0x105F, LOAD+exec_path        ; MOV R1,@#exec_path
    dw 0x890B                       ; SYS exec: try literal pathname first
exec_path:
    dw 0, LOAD+arguments
    dw 0x17C1, LOAD+arguments
    dw 0x15C2, LOAD+path_tail
copy_path:
    dw 0x9452                       ; MOVB (R1)+,(R2)+ (bounded by input)
    dw 0x0302
    dw 0x005F, LOAD+copy_path
    dw 0x890B, LOAD+path_buffer, LOAD+arguments
    dw 0x15C1, LOAD+exec_message
    dw 0x15C2, exec_message_end-exec_message
    dw 0x09DF, LOAD+write_error
    dw 0x005F, LOAD+leave
exit_builtin:
    dw 0x09DF, LOAD+stateful_begin
    dw 0x25DF, 1, LOAD+argument_count ; CMP #1,@#argument_count
    dw 0x0302
    dw 0x005F, LOAD+argument_error
leave:
    dw 0x8901                       ; SYS exit: original /bin/sh resumes
help_builtin:
    dw 0x25DF, 1, LOAD+argument_count
    dw 0x0302
    dw 0x005F, LOAD+argument_error
    dw 0x09DF, LOAD+pure_begin
    dw 0x15C1, LOAD+help_message
    dw 0x15C2, help_message_end-help_message
    dw 0x09DF, LOAD+write_string
    dw 0x005F, LOAD+builtin_done
version_builtin:
    dw 0x25DF, 1, LOAD+argument_count
    dw 0x0302
    dw 0x005F, LOAD+argument_error
    dw 0x09DF, LOAD+pure_begin
    dw 0x15C1, LOAD+version_message
    dw 0x15C2, version_message_end-version_message
    dw 0x09DF, LOAD+write_string
    dw 0x005F, LOAD+builtin_done
plain_builtin:
    dw 0x09DF, LOAD+stateful_begin
    dw 0x25DF, 1, LOAD+argument_count
