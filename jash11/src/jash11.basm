argument_error:
    dw 0x15C1, LOAD+argument_message
    dw 0x15C2, argument_message_end-argument_message
    dw 0x005F, LOAD+report_error
syntax_error:
    dw 0x15C1, LOAD+syntax_message
    dw 0x15C2, syntax_message_end-syntax_message
    dw 0x005F, LOAD+report_error
quote_error:
    dw 0x15C1, LOAD+quote_message
    dw 0x15C2, quote_message_end-quote_message
    dw 0x005F, LOAD+report_error
directory_error:
    dw 0x15C1, LOAD+directory_message
    dw 0x15C2, directory_message_end-directory_message
    dw 0x005F, LOAD+report_error
fork_error:
    dw 0x15C1, LOAD+fork_message
    dw 0x15C2, fork_message_end-fork_message
