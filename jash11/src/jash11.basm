    dw 0x0202
    dw 0x005F, LOAD+completion_next_directory
    dw 0x25C0, 10
    dw 0x0302
    dw 0x005F, LOAD+completion_read_error
    dw 0x0BDF, LOAD+completion_entry
    dw 0x0202
    dw 0x005F, LOAD+completion_read
    dw 0x17C1, LOAD+completion_prefix
    dw 0x15C2, LOAD+completion_entry+2
