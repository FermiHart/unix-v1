    dw 0x15C2, 2
    dw 0x09DF, LOAD+write_string
    dw 0x1100
    dw 0x09DF, LOAD+history_address
    dw 0x1081
    dw 0x1043
history_length:
    dw 0x8BD3                       ; TSTB (R3)+
    dw 0x0302
    dw 0x005F, LOAD+history_length
    dw 0x0AC3
    dw 0x10C2
