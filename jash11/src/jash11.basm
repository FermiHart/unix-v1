    dw 0x0A1F, LOAD+completion_matches
    dw 0x0A1F, LOAD+completion_phase
    dw 0x0A1F, LOAD+completion_dir_length
    dw 0x17C1, LOAD+arguments+2
    dw 0x105F, LOAD+completion_arg
