    dw 0x0302
    dw 0x005F, LOAD+completion_compare_start
    dw 0xA5C9, 46
    dw 0x0302
    dw 0x005F, LOAD+completion_read
completion_compare_start:
    dw 0x15C3, 8
completion_compare:
    dw 0x9440
    dw 0x8BC0
    dw 0x0202
