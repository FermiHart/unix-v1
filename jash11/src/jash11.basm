wait_error:
    dw 0x15C1, LOAD+wait_message
    dw 0x15C2, wait_message_end-wait_message
report_error:
    dw 0x09DF, LOAD+write_error
    dw 0x005F, LOAD+builtin_done
read_error:
    dw 0x15C1, LOAD+read_message
    dw 0x15C2, read_message_end-read_message
    dw 0x09DF, LOAD+write_string
    dw 0x005F, LOAD+leave
; R1=string, R2=length. The V1 syscall argument words are writable data.
write_string:
    dw 0x15C0, 1
    dw 0x005F, LOAD+write_fd
write_error:
    dw 0x17C0, LOAD+error_fd
write_fd:
    dw 0x105F, LOAD+write_pointer
    dw 0x109F, LOAD+write_count
    dw 0x8904
write_pointer:
    dw 0
write_count:
    dw 0
    dw 0x0087                       ; RTS PC
; R1,R2=NUL-terminated strings; R0=1 if equal, otherwise 0.
equal_string:
    dw 0x9440                       ; MOVB (R1)+,R0
    dw 0xA480                       ; CMPB (R2)+,R0
    dw 0x0302
    dw 0x005F, LOAD+not_equal
    dw 0x8BC0
    dw 0x0202
    dw 0x005F, LOAD+is_equal
    dw 0x005F, LOAD+equal_string
not_equal:
    dw 0x0A00
    dw 0x0087
is_equal:
    dw 0x15C0, 1
    dw 0x0087
banner_color:
    db 27, "[96mJash/11: native PDP-11 shell, Unix V1 edition.", 27, "[0m", 10
banner_color_end:
banner:
    db "Jash/11: native PDP-11 shell, Unix V1 edition.", 10
banner_end:
color_prompt:
    db 27, "[97m", 27, "[1m"
prompt_mark:
    db "#", 27, "[0m "
color_prompt_end:
plain_prompt:
    db "# "
exit_name: db "exit", 0
help_name: db "help", 0
version_name: db "version", 0
plain_name: db "plain", 0
color_name: db "color", 0
cd_name: db "cd", 0
chdir_name: db "chdir", 0
source_name: db "source", 0
history_name: db "history", 0
complete_name: db "complete", 0
echo_name: db "echo", 0
echo_no_newline: db "-n", 0
space_byte: db " "
dot_directory: db ".", 0
bin_directory: db "/bin", 0
clear_name: db "clear", 0
off_name: db "off", 0
on_name: db "on", 0
newline: db 10
history_prefix: db "1 "
option_plain: db "-p", 0
option_command: db "-c", 0
console_name: db "/dev/tty8", 0
unsupported: db 34, 39, 36, 38, 59, 124, 60, 62, 92, 40, 41, 42, 63, 91, 93, 96, 126, 0
help_message:
    db "Jash/11 1.0: echo, help, version, exit, cd, chdir, plain, color.", 10
    db "source FILE; history [clear|off|on]; !!; !1..!4; complete PREFIX.", 10
    db "Quotes/escapes, < > >>; maximum 8 arguments and 119 input bytes.", 10
    db "Single-line terminal paste is accepted; multiline paste is discarded.", 10
    db "Pipes, jobs, expansion and globbing are not supported.", 10
help_message_end:
version_message: db "Jash/11 1.0 (native Unix V1 edition)", 10
version_message_end:
argument_message: db "Invalid argument count (maximum 8).", 10
argument_message_end:
syntax_message: db "Unsupported shell syntax.", 10
syntax_message_end:
quote_message: db "Unterminated quote or escape; command discarded.", 10
quote_message_end:
directory_message: db "Cannot change directory.", 10
directory_message_end:
fork_message: db "Cannot create process.", 10
fork_message_end:
wait_message: db "Cannot wait for process.", 10
wait_message_end:
exec_message: db "Cannot execute command.", 10
exec_message_end:
read_message: db "Cannot read command.", 10
read_message_end:
long_message: db "Input line too long; command discarded.", 10
long_message_end:
terminal_message: db "Unsupported terminal escape or control input; command discarded.", 10
terminal_message_end:
multiline_message: db "Multiline paste is not supported; entire paste discarded.", 10
multiline_message_end:
input_redirect_message: db "Cannot redirect input.", 10
input_redirect_message_end:
output_redirect_message: db "Cannot redirect output.", 10
output_redirect_message_end:
builtin_redirect_message: db "Redirection is not supported for this builtin.", 10
builtin_redirect_message_end:
usage_message: db "Usage: jash [-p] [-c COMMAND | FILE]", 10
usage_message_end:
source_message: db "Cannot open command file.", 10
source_message_end:
nested_source_message: db "Nested source is not supported.", 10
nested_source_message_end:
history_empty_message: db "History is empty.", 10
history_empty_message_end:
history_error_message: db "History entry is unavailable (interactive !! or !1..!4).", 10
history_error_message_end:
completion_empty_message: db "No completions.", 10
completion_empty_message_end:
completion_limit_message: db "Completion limit reached (16).", 10
completion_limit_message_end:
completion_error_message: db "Cannot open completion directory.", 10
completion_error_message_end:
    align 2
