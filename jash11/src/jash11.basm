completion_slash:
    dw 0x9440
    dw 0x8BC0
    dw 0x0202
    dw 0x005F, LOAD+completion_split
    dw 0xA5C0, 47
    dw 0x0302
    dw 0x005F, LOAD+completion_slash
    dw 0x1045
    dw 0x0AC5
    dw 0x005F, LOAD+completion_slash
