    dw 0x0202
    dw 0x005F, LOAD+pure_ready
    dw 0x0BDF, LOAD+in_child
    dw 0x0302
    dw 0x005F, LOAD+pure_ready
    dw 0x0BD6
    dw 0x005F, LOAD+fork_command
pure_ready:
    dw 0x0087
builtin_done:
    dw 0x0BDF, LOAD+in_child
    dw 0x0302
    dw 0x005F, LOAD+leave
    dw 0x005F, LOAD+prompt
input_redirect_error:
    dw 0x15C1, LOAD+input_redirect_message
    dw 0x15C2, input_redirect_message_end-input_redirect_message
    dw 0x005F, LOAD+child_error
output_redirect_error:
